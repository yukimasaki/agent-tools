{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "agent-tools",
      "include-v-in-tag": true,
      "include-component-in-tag": false,
      "extra-files": [
        { "type": "json", "path": ".claude-plugin/marketplace.json", "jsonpath": "$.metadata.version" },
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/agent-graph/.claude-plugin/plugin.json", "jsonpath": "$.version" },
        { "type": "json", "path": "plugins/memgate/.claude-plugin/plugin.json", "jsonpath": "$.version" }
      ]
    }
  }
}
